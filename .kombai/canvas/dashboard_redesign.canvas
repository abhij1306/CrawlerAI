      "html": "\n<div class=\"min-h-screen bg-[#0d0c0a] text-[#f0ebe0] font-sans selection:bg-[#c2410c]/30 selection:text-[#f0ebe0]\" data-theme=\"dark\" data-kid=\"0\">\n  <style data-kid=\"1\">\n    @import url('https://fonts.googleapis.com/css2?family=Public+Sans:wght@300;400;500;600;700&family=Bricolage+Grotesque:wght@600;700;800&family=Ubuntu+Mono:wght@400;700&display=swap');\n\n    :root {\n      --bg-base: #0d0c0a;\n      --bg-alt: #131110;\n      --bg-panel: #1a1714;\n      --bg-elevated: #222019;\n      --bg-well: #2b2822;\n      --border: #2c2820;\n      --border-strong: #413b32;\n      --accent: #c2410c;\n      --accent-text: #ffa875;\n      --success: #34d399;\n      --info: #60a5fa;\n      --warning: #fbbf24;\n      --danger: #f87171;\n    }\n\n    .neural-grid-bg {\n      background-image: \n        radial-gradient(circle at 2px 2px, var(--border) 1px, transparent 0),\n        linear-gradient(to right, rgba(44, 40, 32, 0.05) 1px, transparent 1px),\n        linear-gradient(to bottom, rgba(44, 40, 32, 0.05) 1px, transparent 1px);\n      background-size: 32px 32px, 128px 128px, 128px 128px;\n    }\n\n    .glass-panel {\n      background: rgba(26, 23, 20, 0.7);\n      backdrop-filter: blur(12px);\n      border: 1px solid var(--border);\n    }\n\n    @keyframes pulse-ring {\n      0% { transform: scale(0.95); opacity: 0.5; }\n      50% { transform: scale(1.05); opacity: 0.8; }\n      100% { transform: scale(0.95); opacity: 0.5; }\n    }\n\n    .node-pulse {\n      animation: pulse-ring 3s cubic-bezier(0.4, 0, 0.6, 1) infinite;\n    }\n\n    .syntax-key { color: #9cdcfe; }\n    .syntax-string { color: #ce9178; }\n    .syntax-number { color: #b5cea8; }\n    .syntax-boolean { color: #569cd6; }\n    .syntax-null { color: #569cd6; font-style: italic; }\n    .syntax-punct { color: #d4d4d4; }\n  </style>\n\n  <main class=\"neural-grid-bg p-6 space-y-6\" data-kid=\"2\">\n    \n    <div class=\"page-stack\" data-kid=\"3\">\n      \n      <div class=\"border-border bg-panel flex flex-wrap items-center justify-between gap-3 rounded-lg border px-6 py-4 shadow-sm\" data-kid=\"4\">\n        <div class=\"flex items-center gap-4\" data-kid=\"5\">\n          <div class=\"size-10 flex items-center justify-center rounded-md bg-accent/10 border border-accent/20\" data-kid=\"6\">\n            <svg class=\"size-6 text-accent-text\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" data-kid=\"7\">\n              <path d=\"M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5\" data-kid=\"8\"></path>\n            </svg>\n          </div>\n          <div data-kid=\"9\">\n            <h1 class=\"type-heading-2 m-0 text-[#f0ebe0]\" data-kid=\"10\">Neural Console <span class=\"text-accent-text opacity-70\" data-kid=\"11\">/ Shard-02</span></h1>\n            <p class=\"type-caption-mono text-xs opacity-50 m-0\" data-kid=\"12\">STATUS: CRAWLING_ACTIVE • OPTIMIZED_MODE</p>\n          </div>\n        </div>\n        \n        <div class=\"flex items-center gap-3\" data-kid=\"13\">\n          <div class=\"flex items-center gap-1.5 px-3 py-1.5 bg-success/10 border border-success/20 rounded-full\" data-kid=\"14\">\n            <div class=\"size-2 rounded-full bg-success animate-pulse\" data-kid=\"15\"></div>\n            <span class=\"type-label text-[10px] text-success\" data-kid=\"16\">Live Stream</span>\n          </div>\n          <button class=\"ui-button ui-button-md button-action-surface\" data-kid=\"17\">\n            <span data-kid=\"18\">Run New Sequence</span>\n          </button>\n        </div>\n      </div>\n\n      \n      <div class=\"page-stack\" data-kid=\"19\">\n        <div class=\"border-border/50 flex flex-wrap items-stretch justify-between gap-3 border-b\" data-kid=\"20\">\n          <div class=\"flex items-end\" data-kid=\"21\">\n            <div class=\"workspace-tabs flex p-1 mb-[-1px]\" data-kid=\"22\">\n              <button class=\"workspace-tab px-6\" data-active=\"true\" data-kid=\"23\">Live