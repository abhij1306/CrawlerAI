ta-kid=\"39\">Welcome back, Architect.</h2>\n             <p class=\"type-body text-secondary max-w-md\" data-kid=\"40\">\n               The Neural Grid is currently mapping 4,202 data points across high-velocity ecommerce clusters. Anomaly detection is holding at <span class=\"text-success\" data-kid=\"41\">0.02%</span>.\n             </p>\n             <div class=\"flex gap-4 pt-2\" data-kid=\"42\">\n               <button class=\"ui-button ui-button-sm button-neutral-surface\" data-kid=\"43\">View System Logs</button>\n               <button class=\"ui-button ui-button-sm button-quiet-surface\" data-kid=\"44\">Dismiss</button>\n             </div>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    \n    <div class=\"section-card\" data-kid=\"45\">\n      <div class=\"flex items-center justify-between mb-2\" data-kid=\"46\">\n        <h3 class=\"type-label-mono text-xs flex items-center gap-2\" data-kid=\"47\">\n          <svg class=\"size-4 text-accent\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" data-kid=\"48\">\n            <circle cx=\"12\" cy=\"12\" r=\"10\" data-kid=\"49\"></circle><path d=\"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20\" data-kid=\"50\"></path><path d=\"M2 12h20\" data-kid=\"51\"></path>\n          </svg>\n          Global Node Topology\n        </h3>\n        <div class=\"flex gap-2\" data-kid=\"52\">\n          <span class=\"type-caption-mono text-[10px] opacity-40\" data-kid=\"53\">VIEWPORT_COORD: 40.7128° N, 74.0060° W</span>\n        </div>\n      </div>\n      \n      <div class=\"border-border bg-panel relative h-[480px] overflow-hidden rounded-xl border\" data-kid=\"54\">\n        \n        <div class=\"absolute inset-0 pointer-events-none opacity-20\" style=\"background-image: linear-gradient(var(--border) 1px, transparent 1px), linear-gradient(90deg, var(--border) 1px, transparent 1px); background-size: 40px 40px;\" data-kid=\"55\"></div>\n        \n        \n        <svg class=\"absolute inset-0 h-full w-full pointer-events-none opacity-40\" data-kid=\"56\">\n          <defs data-kid=\"57\">\n            <marker id=\"arrow\" viewBox=\"0 0 10 10\" refX=\"5\" refY=\"5\" markerWidth=\"4\" markerHeight=\"4\" orient=\"auto-start-reverse\" data-kid=\"58\">\n              <path d=\"M 0 0 L 10 5 L 0 10 z\" fill=\"var(--border)\" data-kid=\"59\"></path>\n            </marker>\n          </defs>\n          <path d=\"M 200 150 Q 400 100 720 240\" stroke=\"var(--accent)\" stroke-width=\"1\" fill=\"none\" stroke-dasharray=\"4 4\" data-kid=\"60\"></path>\n          <path d=\"M 720 240 L 1100 180\" stroke=\"var(--accent)\" stroke-width=\"1\" fill=\"none\" data-kid=\"61\"></path>\n          <path d=\"M 720 240 L 950 400\" stroke=\"var(--accent)\" stroke-width=\"1\" fill=\"none\" data-kid=\"62\"></path>\n          <path d=\"M 200 150 L 350 400\" stroke=\"var(--border-strong)\" stroke-width=\"1\" fill=\"none\" data-kid=\"63\"></path>\n        </svg>\n\n        \n        <div class=\"absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 group cursor-pointer\" data-kid=\"64\">\n          <div class=\"relative h-24 w-24 flex items-center justify-center\" data-kid=\"65\">\n            <div class=\"absolute inset-0 rounded-full border border-accent/40 node-pulse\" data-kid=\"66\"></div>\n            <div class=\"absolute inset-[-10px] rounded-full border border-accent/10\" data-kid=\"67\"></div>\n            <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/nested-hexagons.svg\" class=\"size-16 relative z-10 transition-transform group-hover:scale-110\" style=\"color: #ffa875;\" data-kid=\"68\">\n          </div>\n          <div class=\"mt-4 text-center\" data-kid=\"69\">\n             <div class=\"type-label-mono text-[11px] text-accent-text tracking-widest bg-accent/10 px-2 py-0.5 rounded border border-accent/20\" data-kid=\"70\">NEURAL_CORE_01</div>\n          </div>\n        </div>\n\n        \n        <div class=\"absolute left-[15%] top-[25%] group cursor-pointer\" data-kid=\"71\">\n          <div class=\"bg-elevated/80 border border-border p-3 rounded-lg backdrop-blur-md shadow-xl transition-all group-hover:border-info/50 group-hover:translate-y-[-4px]\" data-kid=\"72\">\n             <div class=\"flex items-center gap-2 mb-2\" data-kid=\"73\">\n                <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/plain-circle.svg\" class=\"size-6\" style=\"color: var(--info);\" data-kid=\"74\">\n                <span class=\"type-label text-[10px]\" data-kid=\"75\">US_EAST_CLUSTER</span>\n             </div>\n             <div class=\"grid grid-cols-2 gap-4\" data-kid=\"76\">\n                <div data-kid=\"77\">\n                   <p class=\"type-caption-mono text-[9px] opacity-40 mb-0.5 uppercase\" data-kid=\"78\">Latency</p>\n                   <p class=\"type-metric text-info text-sm\" data-kid=\"79\">24ms</p>\n                </div>\n                <div data-kid=\"80\">\n                   <p class=\"type-caption-mono text-[9px] opacity-40 mb-0.5 uppercase\" data-kid=\"81\">Nodes</p>\n                   <p class=\"type-metric text-sm\" data-kid=\"82\">4.1k</p>\n                </div>\n             </div>\n          </div>\n        </div>\n\n        \n        <div class=\"absolute right-[12%] top-[30%] group cursor-pointer\" data-kid=\"83\">\n          <div class=\"bg-elevated/80 border border-border p-3 rounded-lg backdrop-blur-md shadow-xl transition-all group-hover:border-success/50 group-hover:translate-y-[-4px]\" data-kid=\"84\">\n             <div class=\"flex items-center gap-2 mb-2\" data-kid=\"85\">\n                <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/hexagonal-nut.svg\" class=\"size-6\" style=\"color: var(--success);\" data-kid=\"86\">\n                <span class=\"type-label text-[10px]\" data-kid=\"87\">EU_WEST_CLUSTER</span>\n             </div>\n             <div class=