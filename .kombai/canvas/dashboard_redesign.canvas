</main>\n\n  \n  <footer class=\"fixed bottom-0 left-0 right-0 h-8 bg-[var(--bg-panel)] border-t border-[var(--border-strong)] px-6 flex items-center justify-between z-50\" data-kid=\"276\">\n    <div class=\"flex items-center gap-6\" data-kid=\"277\">\n      <div class=\"flex items-center gap-2\" data-kid=\"278\">\n        <span class=\"w-2 h-2 rounded-full bg-[var(--success)]\" data-kid=\"279\"></span>\n        <span class=\"type-caption-mono text-[10px] font-bold\" data-kid=\"280\">SYSTEM_NOMINAL</span>\n      </div>\n      <div class=\"h-4 w-px bg-[var(--border)]\" data-kid=\"281\"></div>\n      <div class=\"flex items-center gap-2 text-[var(--text-muted)]\" data-kid=\"282\">\n        <i class=\"ti ti-cpu text-xs\" data-kid=\"283\"></i>\n        <span class=\"type-caption-mono text-[10px]\" data-kid=\"284\">CPU: 12%</span>\n      </div>\n      <div class=\"flex items-center gap-2 text-[var(--text-muted)]\" data-kid=\"285\">\n        <i class=\"ti ti-database text-xs\" data-kid=\"286\"></i>\n        <span class=\"type-caption-mono text-[10px]\" data-kid=\"287\">MEM: 4.2GB / 16GB</span>\n      </div>\n    </div>\n    <div class=\"type-caption-mono text-[10px] text-[var(--text-muted)]\" data-kid=\"288\">\n      INVORO_TERMINAL_V3.0.4 • SESSION_ID: 0x4A2...F9\n    </div>\n  </footer>\n</div>\n",
