      "html": "\n<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@600;700;800&family=Public+Sans:wght@400;500;600;700&family=Ubuntu+Mono:wght@400;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --bg-base: #f2f0ec;\n    --bg-alt: #e7e4de;\n    --bg-panel: #faf8f4;\n    --bg-elevated: #ffffff;\n    --bg-well: #dad6cf;\n    --surface-overlay: rgba(242, 240, 236, 0.94);\n    --border-subtle: #e2dfd8;\n    --border: #cdc8c0;\n    --border-strong: #b0a89f;\n    --text-primary: #1a1815;\n    --text-secondary: #443d36;\n    --text-muted: #68614f;\n    --text-subtle: #948d7e;\n    --accent: #c2410c;\n    --accent-hover: #9a3412;\n    --accent-fg: #ffffff;\n    --accent-subtle: rgba(194, 65, 12, 0.09);\n    --accent-soft: rgba(194, 65, 12, 0.05);\n    --accent-border: rgba(194, 65, 12, 0.26);\n    --success: #059669;\n    --success-bg: #ecfdf5;\n    --danger: #dc2626;\n    --danger-bg: #fef2f2;\n    --warning: #d97706;\n    --warning-bg: #fffbeb;\n    --info: #2563eb;\n    --radius-md: 7px;\n    --radius-lg: 10px;\n    --terminal-bg: #110f0c;\n    --terminal-fg: #f0ebe0;\n    --syntax-key: #9cdcfe;\n    --syntax-string: #ce9178;\n    --syntax-number: #b5cea8;\n    --syntax-boolean: #569cd6;\n    --syntax-punct: #d4d4d4;\n  }\n\n  body {\n    background-color: var(--bg-base);\n    background-image:\n      radial-gradient(circle at 16px 16px, color-mix(in srgb, var(--border) 20%, transparent) 1px, transparent 1.5px),\n      linear-gradient(color-mix(in srgb, var(--border) 7%, transparent) 1px, transparent 1px),\n      linear-gradient(90deg, color-mix(in srgb, var(--border) 7%, transparent) 1px, transparent 1px);\n    background-size: 40px 40px;\n    font-family: 'Public Sans', sans-serif;\n    color: var(--text-primary);\n    margin: 0;\n  }\n\n  .font-display { font-family: 'Bricolage Grotesque', sans-serif; }\n  .font-mono { font-family: 'Ubuntu Mono', monospace; }\n\n  .type-label { font-size: 0.625rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-muted); }\n  .type-heading-1 { font-family: 'Bricolage Grotesque', sans-serif; font-size: 1.8125rem; font-weight: 700; line-height: 1.1; }\n  .type-heading-3 { font-family: 'Bricolage Grotesque', sans-serif; font-size: 1.0625rem; font-weight: 600; }\n  .type-caption-mono { font-family: 'Ubuntu Mono', monospace; font-size: 0.75rem; color: var(--text-muted); }\n\n  .metric-pulse-container { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; }\n  .metric-pulse-item { background: var(--bg-panel); padding: 20px; display: flex; flex-direction: column; gap: 8px; position: relative; transition: background-color 180ms; }\n  .metric-pulse-item:hover { background: var(--bg-elevated); }\n  .metric-pulse-accent { position: absolute; top: 0; left: 0; right: 0; height: 2px; background: var(--accent); opacity: 0; transition: opacity 180ms; }\n  .metric-pulse-item:hover .metric-pulse-accent { opacity: 1; }\n  .metric-pulse-label { font-size: 0.625rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted); display: flex; align-items: center; gap: 8px; }\n  .pulse-dot { width: 6px; height: 6px; border-radius: 999px; background: var(--success); animation: pulse-ring 2s infinite; }\n  @keyframes pulse-ring { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }\n  .ring-glow { position: relative; border-radius: var(--radius-lg); border: 2px solid var(--accent); box-shadow: 0 0 15px color-mix(in srgb, var(--accent) 30%, transparent); }\n\n  .crawl-terminal { background: var(--terminal-bg); color: var(--terminal-fg); border-radius: var(--radius-lg); padding: 16px; font-family: 'Ubuntu Mono', monospace; font-size: 0.8125rem; line-height: 1.5; overflow-y: auto; box-shadow: 0 12px 28px rgba(0,0,0,0.4); }\n  .syntax-key { color: var(--syntax-key); }\n  .syntax-string { color: var(--syntax-string); }\n  .syntax-number { color: var(--syntax-number); }\n  .syntax-boolean { color: var(--syntax-boolean); }\n  .syntax-punct { color: var(--syntax-punct); }\n\n  .compact-data-table { width: 100%; border-collapse: separate; border-spacing: 0; }\n  .compact-data-table thead th { background: var(--bg-alt); padding: 12px 16px; text-align: left; font-size: 0.625rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted); border-bottom: 1px solid var(--border); }\n  .compact-data-table tbody td { padding: 12px 16px; border-bottom: 1px solid var(--border-subtle); vertical-align: middle; }\n  .compact-data-table tbody tr:hover { background: var(--bg-alt); }\n  .ct-image-wrap { width: 44px; height: 44px; overflow: hidden; border-radius: 7px; border: 1px solid var(--border); background: var(--bg-alt); display: flex; align-items: center; justify-content: center; transition: border-color 180ms; }\n  .ct-image-wrap img { width: 100%; height: 100%; object-fit: cover; }\n\n  .surface-muted { border: 1px solid var(--border); background: var(--bg-alt); }\n  .ui-button { height: 38px; padding-inline: 14px; font-size: 0.8125rem; font-weight: 600; border-radius: 7px; border: 1px solid transparent; display: inline-flex; align-items: center; gap: 8px; cursor: pointer; transition: all 100ms; }\n  .button-action-surface { background: var(--accent); color: white; border-color: var(--accent); }\n  .button-action-surface:hover { background: var(--accent-hover); }\n\n  .animate-pulse-slow { animation: pulse 3s cubic-bezier(0.4, 0, 0.6, 1) infinite; }\n  @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: .7; } }\n</style>\n\n<div class=\"min-h-screen flex flex-col pb-20\" data-kid=\"1\">\n  \n  <header class=\"sticky top-0 z-50 bg-[var(--surface-overlay)] backdrop-blur-md border-b border-[var(--border)] px-8 h-16 flex items-center justify-between\" data-kid=\"2\">\n    <div class=\"flex items-center gap-6\" data-kid=\"3\">\n      <div class=\"flex flex-col\" data-kid=\"4\">\n        <span class=\"type-label\" data-kid=\"5\">Cognitive Console</span>\n        <h1 class=\"font-display text-xl leading-none\" data-kid=\"6\">Intelligence Command</h1>\n      </div>\n      <div class=\"h-6 w-px bg-[var(--border)]\" data-kid=\"7\"></div>\n      <div class=\"relative w-80\" data-kid=\"8\">\n        <i class=\"ti ti-search absolute left-3 top-1/2 -translate-y-1/2 text-[var(--text-muted)] text-sm\" data-kid=\"9\"></i>\n        <input type=\"text\" placeholder=\"Global AI Insight Search...\" class=\"w-full bg-[var(--bg-panel)] border border-[var(--border)] rounded-md pl-9 pr-4 py-1.5 text-sm focus:outline-none focus:border-[var(--accent)] focus:ring-2 focus:ring-[var(--accent-soft)] transition-all\" data-kid=\"10\">\n      </div>\n    </div>\n    <div class=\"flex items-center gap-4\" data-kid=\"11\">\n      <div class=\"flex items-center gap-3 bg-[var(--bg-panel)] px-3 py-1.5 rounded-md border border-[var(--border-subtle)]\" data-kid=\"12\">\n        <div class=\"flex -space-x-1.5\" data-kid=\"13\">\n          <img src=\"https://i.pravatar.cc/24?u=1\" class=\"size-6 rounded-full border-2 border-[var(--bg-panel)]\" alt=\"AI Agent\" decoding=\"async\" loading=\"lazy\" data-kid=\"14\">\n          <img src=\"https://i.pravatar.cc/24?u=2\" class=\"size-6 rounded-full border-2 border-[var(--bg-panel)]\" alt=\"AI Agent\" decoding=\"async\" loading=\"lazy\" data-kid=\"15\">\n        </div>\n        <div class=\"flex flex-col\" data-kid=\"16\">\n          <span class=\"text-[10px] font-bold text-[var(--success)] leading-none\" data-kid=\"17\">99.8% HEALTH</span>\n          <span class=\"type-caption-mono text-[9px] uppercase\" data-kid=\"18\">Clusters Synced</span>\n        </div>\n      </div>\n      <button class=\"ui-button button-action-surface shadow-lg shadow-[var(--accent-soft)]\" data-kid=\"19\">\n        <i class=\"ti ti-sparkles text-sm\" data-kid=\"20\"></i>\n        <span data-kid=\"21\">Generate Insights</span>\n      </button>\n    </div>\n  </header>\n\n  <main class=\"p-8 space-y-8 max-w-[1600px] mx-auto w-full\" data-kid=\"22\">\n    \n    <section data-kid=\"23\">\n      <div class=\"metric-pulse-container\" data-kid=\"24\">\n        <div class=\"metric-pulse-item group/metric\" data-kid=\"25\">\n          <div class=\"metric-pulse-accent\" data-kid=\"26\"></div>\n          <div class=\"metric-pulse-label\" data-kid=\"27\">\n            <i class=\"ti ti-database text-sm\" data-kid=\"28\"></i>\n            Total Products Extracted\n          </div>\n          <div class=\"font-mono text-[42px] leading-none font-bold tracking-tight text-[var(--text-primary)] mt-1\" data-kid=\"29\">1,842,904</div>\n          <div class=\"type-caption-mono text-[var(--success)] mt-1 flex items-center gap-1\" data-kid=\"30\">\n            <i class=\"ti ti-arrow-up-right text-xs\" data-kid=\"31\"></i> +14.2% from source\n          </div>\n        </div>\n        <div class=\"metric-pulse-item group/metric\" data-kid=\"32\">\n          <div class=\"metric-pulse-accent\" data-kid=\"33\"></div>\n          <div class=\"metric-pulse-label\" data-kid=\"34\">\n            <i class=\"ti ti-activity text-sm\" data-kid=\"35\"></i>\n            Active Crawlers\n            <div class=\"pulse-dot ml-auto\" data-kid=\"36\"></div>\n          </div>\n          <div class=\"font-mono text-[42px] leading-none font-bold tracking-tight text-[var(--accent)] mt-1\" data-kid=\"37\">126</div>\n          <div class=\"type-caption-mono mt-1\" data-kid=\"38\">Concurrency: 4,000 req/s</div>\n        </div>\n        <div class=\"metric-pulse-item group/metric ring-glow border-2 bg-[var(--bg-elevated)]\" data-kid=\"39\">\n          <div class=\"metric-pulse-accent opacity-100\" data-kid=\"40\"></div>\n          <div class=\"metric-pulse-label\" data-kid=\"41\">\n            <i class=\"ti ti-alert-triangle text-[var(--danger)] text-sm\" data-kid=\"42\"></i>\n            AI Price Anomalies\n          </div>\n          <div class=\"font-mono text-[42px] leading-none font-bold tracking-tight text-[var(--danger)] mt-1\" data-kid=\"43\">04</div>\n          <div class=\"type-caption-mono text-[var(--danger)] mt-1 font-bold\" data-kid=\"44\">CRITICAL_ACTION_REQUIRED</div>\n        </div>\n        <div class=\"metric-pulse-item group/metric\" data-kid=\"45\">\n          <div class=\"metric-pulse-accent\" data-kid=\"46\"></div>\n          <div class=\"metric-pulse-label\" data-kid=\"47\">\n            <i class=\"ti ti-globe text-sm\" data-kid=\"48\"></i>\n            Unique Domains\n          </div>\n          <div class=\"font-mono text-[42px] leading-none font-bold tracking-tight text-[var(--text-primary)] mt-1\" data-kid=\"49\">842</div>\n          <div class=\"type-caption-mono mt-1\" data-kid=\"50\">Bypass success: 94.2%</div>\n        </div>\n      </div>\n    </section>\n\n    \n    <section class=\"grid grid-cols-1 xl:grid-cols-[1.2fr_2fr_1.2fr] gap-6 items-stretch\" data-kid=\"51\">\n      \n      <div class=\"flex flex-col gap-3\" data-kid=\"52\">\n        <div class=\"flex items-center justify-between px-1\" data-kid=\"53\">\n          <div class=\"flex items-center gap-2\" data-kid=\"54\">\n            <i class=\"ti ti-terminal text-[var(--text-muted)] text-sm\" data-kid=\"55\"></i>\n            <span class=\"type-label\" data-kid=\"56\">LIVE_STREAM_LOGS</span>\n          </div>\n          <span class=\"type-caption-mono text-[var(--accent)] flex items-center gap-1.5\" data-kid=\"57\">\n            <span class=\"size-1.5 rounded-full bg-[var(--accent)] animate-pulse\" data-kid=\"58\"></span>\n            CONNECTED_NODE_ALPHA\n          </span>\n        </div>\n        <div class=\"crawl-terminal h-[580px] flex flex-col border border-[var(--border-strong)]\" data-kid=\"59\">\n          <div class=\"flex-1 overflow-y-auto space-y-2.5 scrollbar-hidden\" data-kid=\"60\">\n            <div class