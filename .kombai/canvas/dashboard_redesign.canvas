      "html": "\n<div class=\"min-h-[1000px] bg-[var(--bg-base)] font-sans text-[var(--text-primary)] selection:bg-[var(--accent-subtle)] selection:text-[var(--text-primary)]\" data-kid=\"0\">\n  \n  <style data-kid=\"1\">\n    @import url('https://fonts.googleapis.com/css2?family=Public+Sans:wght@300;400;500;600;700&family=Bricolage+Grotesque:wght@600;700;800&family=Ubuntu+Mono:wght@400;700&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n    :root {\n      --font-primary-family: 'Public Sans', sans-serif;\n      --font-display-family: 'Bricolage Grotesque', sans-serif;\n      --font-mono-family: 'Ubuntu Mono', monospace;\n    }\n\n    @keyframes marquee {\n      0% { transform: translateX(0); }\n      100% { transform: translateX(-50%); }\n    }\n\n    .animate-marquee {\n      display: flex;\n      width: max-content;\n      animation: marquee 40s linear infinite;\n    }\n\n    .animate-marquee:hover {\n      animation-play-state: paused;\n    }\n\n    /* Print-inspired ledger grid */\n    .intelligence-grid {\n      display: grid;\n      grid-template-columns: 240px 1fr 1fr 280px;\n      gap: 1px;\n      background-color: var(--border-strong);\n      border: 1px solid var(--border-strong);\n    }\n\n    .grid-cell {\n      background-color: var(--bg-panel);\n    }\n  </style>\n\n  \n  <header class=\"border-b border-[var(--border-strong)] bg-[var(--bg-panel)] sticky top-0 z-50\" data-kid=\"2\">\n    \n    <div class=\"flex items-center justify-between px-6 h-14\" data-kid=\"3\">\n      <div class=\"flex items-center gap-10\" data-kid=\"4\">\n        <div class=\"flex items-center gap-2.5\" data-kid=\"5\">\n          <div class=\"w-7 h-7 bg-[var(--accent)] rounded-[3px] flex items-center justify-center text-white shadow-sm\" data-kid=\"6\">\n            <i class=\"ti ti-bolt text-lg\" data-kid=\"7\"></i>\n          </div>\n          <span class=\"font-display font-extrabold text-xl tracking-tighter up