    </div>\n                <div class=\"flex items-center gap-3\" data-kid=\"109\">\n                   <span class=\"size-2 rounded-full bg-success\" data-kid=\"110\"></span>\n                   <span class=\"type-label text-[10px]\" data-kid=\"111\">Edge Node Verified</span>\n                </div>\n             </div>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    \n    <div class=\"section-card\" data-kid=\"112\">\n      <div class=\"flex items-center justify-between\" data-kid=\"113\">\n        <h3 class=\"type-label-mono text-xs flex items-center gap-2\" data-kid=\"114\">\n          <svg class=\"size-4 text-accent\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" data-kid=\"115\">\n            <rect width=\"20\" height=\"20\" x=\"2\" y=\"2\" rx=\"2\" data-kid=\"116\"></rect><path d=\"M12 18V6\" data-kid=\"117\"></path><path d=\"M6 12h12\" data-kid=\"118\"></path>\n          </svg>\n          Real-time Extraction Ledger\n        </h3>\n        <div class=\"flex items-center gap-4\" data-kid=\"119\">\n           <div class=\"flex items-center gap-2\" data-kid=\"120\">\n              <span class=\"type-caption text-xs opacity-50\" data-kid=\"121\">Filter Cluster:</span>\n              <button class=\"bg-well border border-border px-2 py-1 rounded text-[10px] font-mono flex items-center gap-2\" data-kid=\"122\">\n                 ALL_DOMAINS <svg class=\"size-3\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" data-kid=\"123\"><path d=\"m6 9 6 6 6-6\" data-kid=\"124\"></path></svg>\n              </button>\n           </div>\n           <button class=\"text-accent-text hover:text-accent type-label text-[10px] font-bold\" data-kid=\"125\">EXPORT_DATA_LAKE</button>\n        </div>\n      </div>\n\n      <div class=\"border-border bg-panel overflow-hidden rounded-xl border\" data-kid=\"126\">\n        <table class=\"compact-data-table commerce-table w-full\" data-kid=\"127\">\n          <thead data-kid=\"128\">\n            <tr data-kid=\"129\">\n              <th class=\"w-[30%]\" data-kid=\"130\">Domain Cluster / Target</th>\n              <th data-kid=\"131\">Extraction Path</th>\n              <th class=\"w-32 text-right\" data-kid=\"132\">JSON Size</th>\n              <th class=\"w-56\" data-kid=\"133\">AI Confidence</th>\n              <th class=\"w-16\" data-kid=\"134\"></th>\n            </tr>\n          </thead>\n          <tbody data-kid=\"135\">\n            \n            <tr class=\"group hover:bg-alt/50 cursor-pointer\" data-kid=\"136\">\n              <td data-kid=\"137\">\n                <div class=\"flex items-center gap-3 px-1\" data-kid=\"138\">\n                  <div class=\"size-2 rounded-full bg-success shadow-[0_0_8px_var(--success)]\" data-kid=\"139\"></div>\n                  <div class=\"flex flex-col\" data-kid=\"140\">\n                    <span class=\"font-mono text-xs font-bold text-accent-text\" data-kid=\"141\">amazon.com/dp/*</span>\n                    <span class=\"type-caption text-[10px] opacity-40\" data-kid=\"142\">Extracted from 12 shards</span>\n                  </div>\n                </div>\n              </td>\n              <td data-kid=\"143\"><span class=\"type-caption-mono text-[11px] opacity-70\" data-kid=\"144\">/product/details/price_block_v2</span></td>\n              <td class=\"type-caption-mono text-right font-bold\" data-kid=\"145\">4.21 KB</td>\n              <td class=\"py-2\" data-kid=\"146\">\n                <div class=\"flex flex-col gap-1 pr-6\" data-kid=\"147\">\n                   <div class=\"h-1 w-full bg-border rounded-full overflow-hidden\" data-kid=\"148\">\n                     <div class=\"h-full bg-accent\" style=\"width: 98%;\" data-kid=\"149\"></div>\n                   </div>\n                   <div class=\"flex justify-between items-center text-[9px] font-mono opacity-60\" data-kid=\"150\">\n                      <span class=\"text-success\" data-kid=\"151\">HIGH_PRE