APP_ENV=development

FRONTEND_URL=http://127.0.0.1:3001
FRONTEND_ORIGINS=

JWT_SECRET_KEY=replace-with-64-byte-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=1
ENCRYPTION_KEY=replace-with-32-byte-minimum-secret

POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-local-postgres-password
POSTGRES_DB=crawlerai
# Supply DATABASE_URL directly, or leave it blank and provide all DATABASE_*
# components. The application URL-encodes user/password/name centrally.
DATABASE_URL=postgresql+asyncpg://postgres:replace-with-local-postgres-password@127.0.0.1:5433/crawlerai
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5433
DATABASE_NAME=crawlerai
DATABASE_USER=postgres
DATABASE_PASSWORD=replace-with-local-postgres-password
REDIS_URL=redis://localhost:6379/1
REDIS_STATE_ENABLED=true
CELERY_DISPATCH_ENABLED=true
CRAWLERAI_WORKER_COUNT=2
BROWSER_POOL_SIZE=8

ARTIFACTS_DIR=./backend/artifacts
COOKIE_STORE_DIR=./backend/cookie_store
PLAYWRIGHT_HEADLESS=true

ANTHROPIC_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=

REQUEST_ID_HEADER=X-Request-ID
CRAWL_LOG_DB_MIN_LEVEL=info
CRAWL_LOG_DB_URL_PROGRESS_SAMPLE_RATE=4
CRAWL_LOG_DB_MAX_ROWS_PER_RUN=1000
CRAWL_LOG_FILE_ENABLED=true
LOGFIRE_ENABLED=false
LOGFIRE_SEND_TO_LOGFIRE=if-token-present
LOGFIRE_TOKEN=
LOGFIRE_SERVICE_NAME=crawlerai-backend
LOGFIRE_ENVIRONMENT=development
LOGFIRE_BASE_URL=https://logfire-us.pydantic.dev
LOGFIRE_CAPTURE_HEADERS=false
LOGFIRE_ENABLED_IN_TESTS=false
SYSTEM_MAX_CONCURRENT_URLS=8

DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=replace-with-strong-admin-password
BOOTSTRAP_ADMIN_ONCE=false
REGISTRATION_ENABLED=false

# Bearer token for /api/metrics outside dev/test; leave empty to keep the
# endpoint disabled (404) in non-dev environments.
METRICS_AUTH_TOKEN=

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=600
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_PRE_PING=true
